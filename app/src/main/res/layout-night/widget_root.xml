<?xml version="1.0" encoding="utf-8"?>
<!-- The whole widget is one rendered image. layout-night swaps which image is
     visible so the "Auto" background follows the phone's light/dark mode. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_image_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitCenter"
        android:visibility="visible" />

    <!-- Keep the visible control compact while providing a full touch target. -->
    <FrameLayout
        android:id="@+id/widget_refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/widget_refresh_desc">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_refresh_bg"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh" />
    </FrameLayout>
</FrameLayout>
