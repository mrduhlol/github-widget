<?xml version="1.0" encoding="utf-8"?>
<!-- The whole widget is one rendered image. layout-night swaps which image is
     visible so the "Auto" background follows the phone's light/dark mode. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_image_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitXY"
        android:visibility="visible" />

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_refresh_bg"
        android:contentDescription="@string/widget_refresh_desc"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
