<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#010409"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GH://HOME"
        android:textColor="#3FB950"
        android:textSize="12sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/home_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="GH-widgets"
        android:textColor="#F0F6FC"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:typeface="monospace" />

    <!-- Username -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hint="GitHub username"
            app:boxBackgroundColor="#0D1117"
            app:boxStrokeColor="#30363D"
            app:hintTextColor="#8B949E">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/home_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="52dp"
                android:singleLine="true"
                android:textColor="#F0F6FC"
                android:textColorHint="#8B949E" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_save"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Save"
            android:textSize="13sp"
            app:backgroundTint="#2EA043"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Live widget preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/st_preview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#30363D"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/st_preview_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/st_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@user"
                            android:textColor="#F0F6FC"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/st_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textColor="#8B949E"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/st_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textColor="#3FB950"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:typeface="monospace" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/st_graph"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Widget preview graph"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/st_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Go row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_activity"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Activity"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_share"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Share"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_settings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_add_widget"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Add widget to homescreen"
        android:textSize="13sp"
        app:backgroundTint="#2EA043"
        app:cornerRadius="12dp" />

    <!-- Appearance -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Appearance"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Theme"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/st_themes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/st_theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Matrix"
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:typeface="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Widget style"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_styles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <!-- Graph -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Graph"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Range"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_ranges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Cell shape"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_shapes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cell size"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_cellsize_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_cellsize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="1"
        android:valueFrom="0.8"
        android:valueTo="1.3"
        android:stepSize="0.05" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cell spacing"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_spacing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="1"
        android:valueFrom="0.5"
        android:valueTo="1.5"
        android:stepSize="0.5" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Contribution palette"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_palette_generate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="From theme color"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_palette_reset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Follow theme"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Background -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Background"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/st_bgtypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/st_solid_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Color"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_bgcolor"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text=""
            app:backgroundTint="#0D1117"
            app:cornerRadius="26dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/st_gradient_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gradient colors"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/st_grad_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text=""
                app:backgroundTint="#0D1117"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/st_grad_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text=""
                app:backgroundTint="#1F6FEB"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/st_grad_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text=""
                app:backgroundTint="#A371F7"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/st_grad_third"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Three colors"
            android:textColor="#F0F6FC" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/st_grad_radial"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Radial"
            android:textColor="#F0F6FC" />

        <LinearLayout
            android:id="@+id/st_angles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/st_image_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/st_image_pick"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Choose image"
                android:textSize="12sp"
                app:backgroundTint="#21262D"
                app:cornerRadius="12dp"
                app:strokeColor="#30363D"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/st_image_remove"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Remove"
                android:textSize="12sp"
                app:backgroundTint="#21262D"
                app:cornerRadius="12dp"
                app:strokeColor="#30363D"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/st_scales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/st_image_graph"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Image through graph cells"
            android:textColor="#F0F6FC" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Background opacity"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_bgopacity_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_bgopacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="100"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Blur"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_blur_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Off"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="25"
        android:stepSize="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Overlay"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_overlays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Overlay opacity"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_overlayop_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_overlayop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="80"
        android:stepSize="5" />

    <!-- Content -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Content"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/st_chk_total"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Contribution count"
        android:textColor="#F0F6FC" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/st_chk_streak"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Current streak"
        android:textColor="#F0F6FC" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/st_chk_longest"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Longest streak"
        android:textColor="#F0F6FC" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/st_chk_updated"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Last updated"
        android:textColor="#F0F6FC" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/st_chk_active"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Active days"
        android:textColor="#F0F6FC" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Custom label (replaces footer line)"
        app:boxBackgroundColor="#0D1117"
        app:boxStrokeColor="#30363D"
        app:hintTextColor="#8B949E">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/st_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:minHeight="52dp"
            android:singleLine="true"
            android:textColor="#F0F6FC"
            android:textColorHint="#8B949E" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Text size"
        android:textColor="#8B949E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/st_textsizes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Corner roundness"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/st_corners_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16dp"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/st_corners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:value="16"
        android:valueFrom="0"
        android:valueTo="28"
        android:stepSize="2" />

    <!-- Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Presets"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/st_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_reset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Reset look"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_draw"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Draw background"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Look transfer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Look transfer"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_export"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Share look"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/st_import"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Import look"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Widget actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_refresh"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Refresh"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_switch"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Switch user"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
