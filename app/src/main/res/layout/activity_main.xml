<com.google.android.material.textfield.TextInputEditText android:id="@+id/st_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:minHeight="52dp" android:singleLine="true" android:textColor="@color/text_primary" />
</com.google.android.material.textfield.TextInputLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Text size" style="@style/Text.Label" /><LinearLayout android:id="@+id/st_textsizes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Corner roundness" style="@style/Text.Label" />
<TextView android:id="@+id/st_corners_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16dp" style="@style/Text.Body" android:textColor="@color/text_primary" />
</LinearLayout>
<com.google.android.material.slider.Slider android:id="@+id/st_corners" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="16" android:valueFrom="0" android:valueTo="28" android:stepSize="2" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Look transfer" style="@style/Text.Section" />
