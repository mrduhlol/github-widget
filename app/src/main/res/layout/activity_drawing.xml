<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp"
        android:paddingStart="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drawing Studio" />

            <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Draw a background for your widget." />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawing_undo"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="Undo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawing_redo"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="Redo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawing_clear"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="Clear"
            android:textColor="@color/danger" />
    </LinearLayout>

    <com.example.githubwidget.DrawingView
        android:id="@+id/drawing_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="Drawing canvas" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/drawing_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp"
        android:paddingStart="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawing_color"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Brush color"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:text=""
            app:backgroundTint="@color/accent"
            app:cornerRadius="24dp"
            app:strokeColor="@color/stroke_strong"
            app:strokeWidth="2dp" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Size" />

        <com.google.android.material.slider.Slider
            android:id="@+id/drawing_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:stepSize="2"
            android:value="24"
            android:valueFrom="4"
            android:valueTo="96" />

        <TextView
            android:id="@+id/drawing_size_text"
            style="@style/Text.Label"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="24px"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawing_save"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Save PNG"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawing_share"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Share"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawing_use_bg"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Use as background"
                android:textSize="13sp" />
        </LinearLayout>
</LinearLayout>
