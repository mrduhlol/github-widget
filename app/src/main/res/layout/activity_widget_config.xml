<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget setup" />

            <TextView style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Set up your widget" />

            <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="These options apply to this widget only. The app holds the defaults for new widgets." />

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cfg_preview_title"
                        style="@style/Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Preview" />

                    <TextView
                        android:id="@+id/cfg_preview_caption"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cfg_preview_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">

                <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GitHub username" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="e.g. torvalds">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/cfg_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="48dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">

                <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appearance" />
        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Theme" />

                <LinearLayout
                    android:id="@+id/cfg_themes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Widget style" />

                <LinearLayout
                    android:id="@+id/cfg_styles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Graph range" />

                <LinearLayout
                    android:id="@+id/cfg_ranges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/Text.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Transparency" />

                    <TextView
                        android:id="@+id/cfg_opacity_text"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/cfg_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:stepSize="5"
                    android:value="100"
                    android:valueFrom="20"
                    android:valueTo="100" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">

                <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget information" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:layout_marginTop="2dp" android:text="Choose which stats appear on the widget." />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cfg_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Contribution count"
                android:textColor="@color/text_primary" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cfg_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Current streak"
                android:textColor="@color/text_primary" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cfg_longest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Longest streak"
                android:textColor="@color/text_primary" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cfg_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Last updated"
                android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingBottom="14dp"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:paddingTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cfg_save"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add widget" />
    </FrameLayout>
</LinearLayout>
